{% extends 'dashboard_base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
<h1 class="head_title">User</h1>
<div class="content-box">
    <table class="table">
        <tbody>
            <tr>
                <th>Profile Picture</th>
                <td><img 
                src="{{ asset('uploads/profile/' ~ (user.profilePicture ?: 'default.png')) }}"
                class="profile-img"
                onerror="this.onerror=null;this.src='{{ asset('uploads/profile/default.png') }}';">
                </td>
            </tr>
            <tr>
                <th>ID</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Username</th>
                <td>{{ user.username }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>
    {% for role in user.roles %}
        {% if role == 'ROLE_ADMIN' %}
            <span style="background:red; color:white; padding:3px 6px; border-radius:4px; font-size:12px; display:inline-block; margin-bottom:2px;">
                ADMIN
            </span>

        {% elseif role == 'ROLE_STAFF' %}
            <span style="background:purple; color:white; padding:3px 6px; border-radius:4px; font-size:12px; display:inline-block; margin-bottom:2px;">
                STAFF
            </span>

        {% elseif role == 'ROLE_USER' %}
            <span style="background:blue; color:white; padding:3px 6px; border-radius:4px; font-size:12px; display:inline-block; margin-bottom:2px;">
                USER
            </span>
        {% endif %}
    {% endfor %}
            </td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>{{ user.firstName }}</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>Birth Date</th>
                <td><span class="datetime-date" style="color: #555555;">
                    {{ user.birthDate ? user.birthDate|date('F j, Y', 'Asia/Manila') }}</td>
                    </span>
                </td>
            </tr>
            <tr>
                <th>Date & Time Created</th>
                <td><div class="datetime-wrapper">
                    <span class="datetime-date">
                    {{ user.dateTimeCreated|date('F j, Y', 'Asia/Manila') }}
                    </span>
                    <span class="datetime-time">
                    {{ user.dateTimeCreated|date('g:i A', 'Asia/Manila') }}
                    </span>
            </div></td>
            </tr>
        </tbody>
    </table>

<div class="actions">
    <a class="btn btn-secondary" href="{{ path('app_user_index') }}">🡰 Back</a>

    <a class="btn btn-primary" href="{{ path('app_user_edit', {'id': user.id}) }}">✎ Edit</a>

    {{ include('user/_delete_form.html.twig') }}
</div>
</div>
{% endblock %}


