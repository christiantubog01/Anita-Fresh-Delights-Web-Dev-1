{% extends 'dashboard_base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
<h1 class="head_title">User</h1>
<div class="content-box">
    <table class="table">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ user.id }}</td>
            </tr>
            <tr>
                <th>Username</th>
                <td>{{ user.username }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
                <th>Password</th>
                <td>{{ user.password }}</td>
            </tr>
            <tr>
                <th>First Name</th>
                <td>{{ user.firstName }}</td>
            </tr>
            <tr>
                <th>Last Name</th>
                <td>{{ user.lastName }}</td>
            </tr>
            <tr>
                <th>Birth Date</th>
                <td>{{ user.birthDate ? user.birthDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date & Time Created</th>
                <td>{{ user.dateTimeCreated ? user.dateTimeCreated|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

<div class="actions">
    <a class="btn btn-secondary" href="{{ path('app_user_index') }}">🡰 Back</a>

    <a class="btn btn-primary" href="{{ path('app_user_edit', {'id': user.id}) }}">✎ Edit</a>

    {{ include('user/_delete_form.html.twig') }}
</div>
</div>
{% endblock %}


