{% extends 'base.html.twig' %}

{% block title %}About Us{% endblock %}

{% block body %}

<div class="about-container">

    <h1 class="about-title">About Anita's Fresh Delights</h1>

    <p class="about-intro">
        Anita's Fresh Delights proudly serves authentic Filipino street food made
        with passion and dedication. Our goal is to create a welcoming place where
        everyone can enjoy delicious food and a warm atmosphere.
    </p>

    <div class="about-grid">

        <div class="about-card">
            <h3>⏱ On-Time Operations</h3>
            <p>Our staff ensures that food preparation and service are always on schedule.</p>
        </div>

        <div class="about-card">
            <h3>📋 Well Managed</h3>
            <p>Our team follows organized systems to keep operations smooth and efficient.</p>
        </div>

        <div class="about-card">
            <h3>🧼 Clean & Sanitized</h3>
            <p>We maintain strict hygiene and sanitation standards in our kitchen.</p>
        </div>

        <div class="about-card">
            <h3>⚡ Smooth Service</h3>
            <p>We focus on providing fast and friendly service for every customer.</p>
        </div>

        <div class="about-card">
            <h3>👨‍🍳 Our Dedicated Team</h3>
            <p>Our hardworking team makes it possible to deliver quality food daily.</p>
        </div>

        <div class="about-card">
            <h3>🍢 Filipino Street Food</h3>
            <p>Everyone is welcome to experience the rich taste of Filipino street food.</p>
        </div>

    </div>

</div>

{% endblock %}