{% extends 'dashboard_base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}

<div class="dashboard-card welcome-card">
    <h2>
        Welcome, {{ app.user.firstName ~ " " ~ app.user.lastName }}!
    </h2>
</div>

<div class="dashboard-banner">
    <a href="{{ path('app_home') }}">
        <img src="{{ asset('images/filipino-food-banner.jpg') }}" 
             alt="Visit Home Page Banner">
        <span class="banner-text">🏠︎ Visit Home Page</span>
    </a>
</div>

<div id="dashboard-content">

    <!-- ===================== -->
    <!-- Stats Cards -->
    <!-- ===================== -->
    <div class="dashboard-cards-wrapper">

        <div class="dashboard-card stat-card products-card">
            <h3>Products</h3>
            <p>{{ productCount }}</p>
        </div>

        <div class="dashboard-card stat-card stocks-card">
            <h3>Stocks</h3>
            <p>{{ stockCount }}</p>
        </div>

        <div class="dashboard-card stat-card categories-card">
            <h3>Categories</h3>
            <p>{{ categoryCount }}</p>
        </div>

        <div class="dashboard-card stat-card users-card">
            <h3>Users</h3>
            <p>{{ userCount }}</p>
        </div>

    </div>

    <!-- ===================== -->
    <!-- Products by Category -->
    <!-- ===================== -->
    <div class="products-category-card">

        <h3 style="margin-top:40px; text-align:center;">
            Products by Category
        </h3>

        <div class="dashboard-cards-wrapper">
            {% for category in categories %}
                <div class="dashboard-card stat-card category-product-card">
                    <h4>{{ category.categoryName }}</h4>
                    <p>{{ category.products|length }}</p>
                </div>
            {% else %}
                <div class="dashboard-card stat-card category-product-card">
                    <h4>No categories found</h4>
                </div>
            {% endfor %}
        </div>

    </div>

    <!-- ===================== -->
    <!-- Activity Log (Only 5 Latest) -->
    <!-- ===================== -->
    {% if is_granted('ROLE_ADMIN') %}
        <div class="activity-log">

            <h3>Recent Activity</h3>

            <table id="myTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User ID</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Target Data</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    {% for log in activityLogs %}
                        <tr>

                            <td>{{ log.id ?? '—' }}</td>
                            <td>{{ log.userId ?? '—' }}</td>
                            <td>{{ log.username ?? '—' }}</td>

                            <!-- ROLE BADGE -->
                            <td>
                                {% set role = log.role ?? '' %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span style="background:red; color:white; padding:3px 6px; border-radius:4px;">ADMIN</span>
                                {% elseif role == 'ROLE_STAFF' %}
                                    <span style="background:purple; color:white; padding:3px 6px; border-radius:4px;">STAFF</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span style="background:blue; color:white; padding:3px 6px; border-radius:4px;">USER</span>
                                {% else %}
                                    <span style="background:gray; color:white; padding:3px 6px; border-radius:4px;">UNKNOWN</span>
                                {% endif %}
                            </td>

                            <!-- ACTION BADGE -->
                            <td>
                                {% set action = log.action ?? '' %}
                                {% if action == 'CREATE' %}
                                    <span style="background:green; color:white; padding:3px 6px; border-radius:4px;">CREATE</span>
                                {% elseif action == 'DELETE' %}
                                    <span style="background:red; color:white; padding:3px 6px; border-radius:4px;">DELETE</span>
                                {% elseif action == 'LOGIN' %}
                                    <span style="background:blue; color:white; padding:3px 6px; border-radius:4px;">LOGIN</span>
                                {% elseif action == 'LOGOUT' %}
                                    <span style="background:gray; color:white; padding:3px 6px; border-radius:4px;">LOGOUT</span>
                                {% elseif action == 'UPDATE' %}
                                    <span style="background:purple; color:white; padding:3px 6px; border-radius:4px;">UPDATE</span>
                                {% elseif action == 'REGISTER' %}
                                    <span style="background:teal; color:white; padding:3px 6px; border-radius:4px;">REGISTER</span>
                                {% else %}
                                    <span>{{ action }}</span>
                                {% endif %}
                            </td>

                            <td>{{ log.targetData ?? '—' }}</td>

                            <!-- Date & Time -->
                            <td>
                                {% if log.createdAt %}
                                    <div class="datetime-wrapper">
        <span class="datetime-date">
            {{ log.createdAt|date('F j, Y', 'Asia/Manila') }}
        </span>
        <span class="datetime-time">
            {{ log.createdAt|date('g:i A', 'Asia/Manila') }}
        </span>
                                    </div>
                                {% else %}
                                    —
                                {% endif %}
                            </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" style="text-align:center; padding:10px;">
                                No activity logs found
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div style="margin-top:15px; text-align:right;">
                <a href="{{ path('app_activity_log') }}"
                   style="background:#2c3e50; color:white; padding:6px 12px; border-radius:4px; text-decoration:none;">
                    View All Logs →
                </a>
            </div>

        </div>
    {% endif %}

</div>

{% endblock %}