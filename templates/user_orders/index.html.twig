{% extends 'dashboard_base.html.twig' %}

{% block title %}Manage Orders{% endblock %}

{% block body %}

<h1 class="head_title">MANAGE ORDERS</h1>

{% for message in app.flashes('success') %}

    <div class="alert alert-success">
        {{ message }}
    </div>

{% endfor %}

<table id="myTable" class="display nowrap" style="width:100%">

    <thead>

        <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Total</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>

    </thead>

    <tbody>

        {% for order in orders %}

            <tr>

                <td>
                    #{{ order.id }}
                </td>

                <td>
                    {{ order.user.username }}
                </td>

                <td>
                    ₱{{ order.total }}
                </td>

                <td>

                    <span class="
                        {% if order.status == 'Pending' %}
                            badge bg-warning
                        {% elseif order.status == 'Processing' %}
                            badge bg-info
                        {% elseif order.status == 'Completed' %}
                            badge bg-success
                        {% elseif order.status == 'Cancelled' %}
                            badge bg-danger
                        {% endif %}
                    ">

                        {{ order.status }}

                    </span>

                </td>

                <td>
                    {{ order.createdAt|date('F j, Y h:i A', 'Asia/Manila') }}
                </td>

                <td>

                    <a
                        href="{{ path('app_dashboard_order_show', {
                            id: order.id
                        }) }}"
                        class="btn btn-sm btn-primary"
                    >
                        ➤ View
                    </a>

                </td>

            </tr>

        {% else %}

            <tr>

                <td colspan="6">
                    No orders found.
                </td>

            </tr>

        {% endfor %}

    </tbody>

</table>

{% endblock %}