{% extends 'dashboard_base.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
    <h1 class="head_title">SHOW CATEGORY</h1>

<div class="content-box">
    <table class="table">
        <tbody>
            <tr>
                <th>ID:</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Name:</th>
                <td>{{ category.categoryName }}</td>
            </tr>
            <tr>
                <th>Description:</th>
                <td>{{ category.categoryDescription }}</td>
            </tr>
            <tr>
                <th>Date Created:</th>
                <td>{{ category.dateCreated|date('F j, Y', 'Asia/Manila') }}</td>
            </tr>
        </tbody>
    </table>

    <div class="actions">
    <a class="btn btn-secondary" href="{{ path('app_category_index') }}">🡰 Back</a>

    <a class="btn btn-primary" href="{{ path('app_category_edit', {'id': category.id}) }}">✎ Edit</a>

    {{ include('category/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
