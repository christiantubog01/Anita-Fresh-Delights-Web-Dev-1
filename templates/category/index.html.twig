{% extends 'dashboard_base.html.twig' %}

{% block title %}Category{% endblock %}

{% block body %}
    <h1 class="head_title">CATEGORIES</h1>

    <table id="myTable" class="display">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Date Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
         {% for category in categories %}
        <tr>
            <td>{{ category.id }}</td>
            <td>
            <div class="category-wrapper">
            <div class="category-name">
            {{ category.categoryName }}
            </div>
            </div>
            </td>
            <td>{{ category.categoryDescription }}</td>
            <td>
                <span class="datetime-date">
                    {{ category.dateCreated|date('F j, Y', 'Asia/Manila') }}
                </span>
            </td>
            <td>
    <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-sm btn-primary me-1">➤ Show</a>
    <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-secondary me-1">✎ Edit</a>
    {{ include('category/_delete_form.html.twig') }}    
</td>


                
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="create-btn">
    <a href="{{ path('app_category_new') }}">Create new</a>
    </div>
{% endblock %}
