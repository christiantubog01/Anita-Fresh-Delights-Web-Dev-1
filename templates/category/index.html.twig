{% extends 'dashboard_base.html.twig' %}

{% block title %}Category index{% endblock %}

{% block body %}
<div id="content-div">
    <h1>Category</h1>

    <table id="myTable" class="display">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Date Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
         {% for category in categories %}
        <tr>
            <td>{{ category.id }}</td>
            <td>{{ category.categoryName }}</td>
            <td>{{ category.categoryDescription }}</td>
            <td>{{ category.dateCreated|date('Y-m-d') }}</td>
            <td><a href="{{ path('app_category_show', {'id': category.id}) }}">show</a>
                <a href="{{ path('app_category_edit', {'id': category.id}) }}">edit</a></td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_category_new') }}">Create new</a>
</div>
{% endblock %}
