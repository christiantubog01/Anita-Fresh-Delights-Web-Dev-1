{% extends 'dashboard_base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}

    <h1 class="head_title">PRODUCTS</h1>
    <table id="myTable" class="display nowrap" style="width:100%">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product Name</th>
            <th>Product Description</th>
            <th>Image</th>
            <th>Price</th>
            <th>Category</th>
            <th>Stock Quantity</th>
            <th>Date Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.productName }}</td>
                <td>{{ product.productDescription }}</td>
                <td>
                {% if product.image %}
                                <img src="{{ asset('products/' ~ product.image) }}" alt="{{ product.ProductName }}" class="product-thumb">
                            {% else %}
                                <span class="no-image">No image</span>
                            {% endif %}
                </td>
                <td>₱{{ product.price }} </td>

                {# Category relation (change id to categoryName if you want to display category name)#}
                <td>
    {% if product.category %}
        <div class="category-wrapper">
            <div class="category-name">{{ product.category.categoryName }}</div>
        </div>
    {% else %}
        No Category
    {% endif %}
</td>

                <td>
                <div class="qty-wrapper">
                <div class="stock-qty-product">{{ product.stock ? product.stock.quantity}}</div>
                    <div class="stock-unit">{{ product.stock.unit }}</div>
                </div>
                </td>
                <td><span>
                {{ product.dateCreated|date('F j, Y', 'Asia/Manila') }}
                </span></td>

                <td>
                    <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn btn-sm btn-primary">➤Show</a> 
                    <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-sm btn-secondary">✎Edit</a>
                    {{ include('product/_delete_form.html.twig') }}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
    <div class="create-btn">
    <a href="{{ path('app_product_new') }}">Create new</a>
    </div>
{% endblock %}
