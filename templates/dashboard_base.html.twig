<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Dashboard{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}
    
</head>

<body>
<nav class="dashboard-admin">
    <button class="toggle-btn" id="toggleSidebar">☰</button>
    <span class="brand-title">Dashboard</span>
        <div class="user-actions">
    <a href="{{ path('app_logout') }}" class="logout-btn">Logout</a>
        </div>
</nav>

<div class="d-flex">

    <!-- Sidebar -->
    <div id="sidebar" class="text-white vh-100 p-3">
        <div class="sidebar-logo text-center mb-3">
            <img src="{{ asset('images/Logo.png') }}" alt="Logo" class="img-fluid" />
        </div>

        <h5 class="text-light">Menu</h5>

        <ul class="nav flex-column">
            <li class="nav-item">
                <a href="{{ path('app_dashboard') }}"
                   class="nav-link {% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                    🏠︎ Dashboard
                </a>
            </li>

        {% if is_granted("ROLE_ADMIN") %}
            <li class="nav-item">
                <a href="{{ path('app_user_index') }}"
                   class="nav-link {% if app.request.attributes.get('_route') starts with 'app_user' %}active{% endif %}">
                    ⍜ Users
                </a>
            </li>
        {% endif %}
            <li class="nav-item">
                <a href="{{ path('app_product_index') }}"
                   class="nav-link {% if app.request.attributes.get('_route') starts with 'app_product' %}active{% endif %}">
                   ⌸ Products
                </a>
            </li>

            <li class="nav-item">
                <a href="{{ path('app_category_index') }}"
                   class="nav-link {% if app.request.attributes.get('_route') starts with 'app_category' %}active{% endif %}">
                   ⵌ Categories
                </a>
            </li>

            <li class="nav-item">
                <a href="{{ path('app_stock_index') }}"
                   class="nav-link {% if app.request.attributes.get('_route') starts with 'app_stock' %}active{% endif %}">
                   ⍠ Stocks
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ path('app_dashboard_orders_index') }}"
                    class="nav-link {% if app.request.attributes.get('_route') starts with 'app_dashboard_order' %}active{% endif %}">
                    ➩ Orders
                </a>
            </li>
            {% if is_granted("ROLE_ADMIN") %}
            <li class="nav-item">
                <a href="{{ path('app_activity_log') }}"
                   class="nav-link {% if app.request.attributes.get('_route') starts with 'app_activity_log' %}active{% endif %}">
                    [ ]Activity Logs
                </a>
            </li>
            {% endif %}
        </ul>
        
    </div>

    <!-- Main content -->
    <div id="content" class="flex-grow-1 p-4">
        {% block body %}{% endblock %}
    </div>

</div>

{% block javascripts %}
    {{ encore_entry_script_tags('app') }}
{% endblock %}

</body>
</html>
