{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}

<!-- CONTACT INFO + MAP -->
<section class="contact-section">

    <h1 class="contact-title">Contact Us</h1>
    <p class="contact-tagline">We’d love to hear from you!</p>

    <div class="contact-container">

        <!-- INFO -->
        <div class="contact-info">

            <div class="contact-item">
                <h3>Anita's Fresh Delights</h3>
            </div>

            <div class="contact-item">
                <strong>Email:</strong>
                <p>info@anitasfreshdelights.com</p>
            </div>

            <div class="contact-item">
                <strong>Phone:</strong>
                <p>+63 912 345 6789</p>
            </div>

            <div class="contact-item">
                <strong>Address:</strong>
                <p>Zone 2, Candau-ay, Dumaguete City</p>
            </div>

        </div>

        <!-- MAP -->
        <div class="contact-map">
            <iframe
                src="https://www.google.com/maps?q=Zone+2+Candau-ay+Dumaguete+City&output=embed"
                width="100%"
                height="350"
                style="border:0;"
                allowfullscreen=""
                loading="lazy">
            </iframe>
        </div>

    </div>
</section>

<!-- CTA: JOIN US (SCROLL) -->
<section class="cta-section alt">
    <div class="cta-container">

        <!-- TEXT -->
        <div class="cta-content">
            <h2>Interested in reaching out?</h2>

            <p class="cta-text">
                We are approachable, easy to reach, and always ready to respond. Whether you have inquiries, feedback, or just want to share your experience, feel free to connect with us. We’d love to hear from you!
            </p>

            <a href="#contact-form" class="btn-cta">Join Us</a>
        </div>

        <!-- IMAGE -->
        <div class="cta-image">
            <img src="{{ asset('images/contact_join_us.jpg') }}" alt="Contact us">
        </div>

    </div>
</section>


<!-- CTA: ABOUT -->
<section class="cta-section">
    <h2>Want to know more about us?</h2>
    <a href="{{ path('app_about') }}" class="btn-cta">Learn More About Us</a>
</section>


<!-- CONTACT FORM -->
<section class="contact-form-section" id="contact-form">

    <h1 class="contact-title">Get in Touch</h1>
    <div class="contact-form-card" style="text-align: center; padding: 40px;">
    <p style="text-align: center; padding: 20px;">Submit your inquiries, feedback, or messages through the form below. We value your input and will get back to you as soon as possible.</p>
    <a href="{{ path('app_feedback') }}" class="btn-cta">Submit Feedback</a>
    </div>
    
    {# <div class="contact-form-card">

        <form method="post" action="#">

            <div class="form-row">
