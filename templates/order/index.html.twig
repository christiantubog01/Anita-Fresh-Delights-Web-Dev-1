{% extends 'base.html.twig' %}

{% block title %}My Orders{% endblock %}

{% block body %}

<div class="container mt-5">

    <h1 class="mb-4">My Orders</h1>

    {% if orders is empty %}

        <div class="alert alert-info">
            No orders found.
        </div>

    {% else %}

        <table class="table table-bordered">

            <thead class="table-dark">

                <tr>
                    <th>Order ID</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>View</th>
                </tr>

            </thead>

            <tbody>

                {% for order in orders %}

                    <tr>

                        <td>
                            #{{ order.id }}
                        </td>

                        <td>
                            ₱ {{ order.total }}
                        </td>

                        <td>
                            {{ order.status }}
                        </td>

                        <td>
                            {{ order.createdAt|date('F d, Y h:i A') }}
                        </td>

                        <td>

                            <a
                                href="{{ path('app_order_show', {id: order.id}) }}"
                                class="btn btn-primary btn-sm"
                            >

                                View

                            </a>

                        </td>

                    </tr>

                {% endfor %}

            </tbody>

        </table>

    {% endif %}

</div>

{% endblock %}