{% extends 'dashboard_base.html.twig' %}

{% block title %}Stocks{% endblock %}

{% block body %}
<h1 class="head_title">STOCKS</h1>

<table id="myTable" class="display">
    <thead>
        <tr>
            <th>ID</th>
            <th>Quantity</th>
            <th>Stock Description</th>
            <th>Min. quantity</th>
            <th>Max. quantity</th>
            <th>Unit</th>
            <th>Date Created</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for stock in stocks %}
        {% set isBelowMin = stock.quantity < stock.minQuantity %}
        {% set isAboveMax = stock.quantity > stock.maxQuantity %}

        <tr>
            <td>{{ stock.id }}</td>

            {# QUANTITY COLUMN #}
            <td>
            <div class="qty-wrapper">
            <div class="stock-qty">
                {% if isBelowMin %}
                    <span class="highlight-quantity">
                        {{ stock.quantity }} (At Minimum Quantity)
                    </span>
                {% elseif isAboveMax %}
                    <span class="highlight-quantity">
                        {{ stock.quantity }} (At Max Quantity)
                    </span>
                {% else %}
                    {{ stock.quantity }}
                {% endif %}
            </div>
            </div>
            </td>

            <td>{{ stock.stockDescription }}</td>

            {# MIN QUANTITY COLUMN #}
            <td>
                {% if isBelowMin %}
                    <span class="highlight-quantity">{{ stock.minQuantity }}</span>
                {% else %}
                    {{ stock.minQuantity }}
                {% endif %}
            </td>

            {# MAX QUANTITY COLUMN #}
            <td>
                {% if isAboveMax %}
                    <span class="highlight-quantity">{{ stock.maxQuantity }}</span>
                {% else %}
                    {{ stock.maxQuantity }}
                {% endif %}
            </td>

            <td>
            <div class="qty-wrapper">
            <div class="stock-unit">
            {{ stock.unit }}
            </div>
            </div>
            </td>
            <td>
                <span class="datetime-date">
                    {{ stock.dateCreated ? stock.dateCreated|date('F j, Y', 'Asia/Manila') : '' }}
                </span>
            </td>

            <td>
                <a href="{{ path('app_stock_show', {'id': stock.id}) }}"
                   class="btn btn-sm btn-primary">➤ Show</a>

                <a href="{{ path('app_stock_edit', {'id': stock.id}) }}"
                   class="btn btn-sm btn-secondary">✎ Edit</a>
                {{ include('stock/_delete_form.html.twig') }}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<div class="create-btn">
    <a href="{{ path('app_stock_new') }}">Create new</a>
</div>
{% endblock %}
