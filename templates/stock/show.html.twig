{% extends 'dashboard_base.html.twig' %}

{% block title %}Stock{% endblock %}

{% block body %}
    <h1>Stock</h1>

<div class="content-box">

    <table class="table">
        <tbody>
            <tr>
                <th>ID:</th>
                <td>{{ stock.id }}</td>
            </tr>
            <tr>
                <th>Quantity:</th>
                <td>{{ stock.quantity }}</td>
            </tr>
            <tr>
                <th>Description:</th>
                <td>{{ stock.stockDescription }}</td>
            </tr>
            <tr>
                <th>Min. Quantity:</th>
                <td>{{ stock.minQuantity }}</td>
            </tr>
            <tr>
                <th>Max. Quantity:</th>
                <td>{{ stock.maxQuantity }}</td>
            </tr>
            <tr>
                <th>Unit:</th>
                <td>{{ stock.unit }}</td>
            </tr>
            <tr>
                <th>Date Created:</th>
                <td>{{ stock.dateCreated ? stock.dateCreated|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>
    <div class="actions">
    <a  class="btn btn-secondary" href="{{ path('app_stock_index') }}">🡰 Back</a>

    <a class="btn btn-primary" href="{{ path('app_stock_edit', {'id': stock.id}) }}">✎ Edit</a>

    {{ include('stock/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
