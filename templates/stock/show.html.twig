{% extends 'dashboard_base.html.twig' %}

{% block title %}Stock{% endblock %}

{% block body %}
    <h1>Stock</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ stock.id }}</td>
            </tr>
            <tr>
                <th>Quantity</th>
                <td>{{ stock.quantity }}</td>
            </tr>
            <tr>
                <th>Stock_description</th>
                <td>{{ stock.stockDescription }}</td>
            </tr>
            <tr>
                <th>Min_quantity</th>
                <td>{{ stock.minQuantity }}</td>
            </tr>
            <tr>
                <th>Max_quantity</th>
                <td>{{ stock.maxQuantity }}</td>
            </tr>
            <tr>
                <th>Unit</th>
                <td>{{ stock.unit }}</td>
            </tr>
            <tr>
                <th>Date_created</th>
                <td>{{ stock.dateCreated ? stock.dateCreated|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_stock_index') }}">back to list</a>

    <a href="{{ path('app_stock_edit', {'id': stock.id}) }}">edit</a>

    {{ include('stock/_delete_form.html.twig') }}
{% endblock %}
