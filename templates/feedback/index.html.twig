{% extends 'base.html.twig' %}

{% block title %}Submit Feedback{% endblock %}

{% block body %}

<section class="contact-form-section" id="contact-form" style="padding: 60px 20px;  border-radius: 10px; margin-top: 40px;">

    <h1 class="contact-title">Get in Touch</h1>
    <p style="text-align: center; padding: 20px;">
        Submit your inquiries, feedback, or messages through the form below. We value your input and will get back to you as soon as possible.
    </p>
    <div class="contact-form-card">
        <iframe 
            src="https://docs.google.com/forms/d/e/1FAIpQLSeBBeLxX1VJcljLo0EkqkwfIur-D5PVYXUoC882b_r2W8aUKw/viewform?embedded=true" 
            width="100%" 
            height="800" 
            frameborder="0" 
            marginheight="0" 
            marginwidth="0">
            Loading…
        </iframe>
    </div>

</section>
{% endblock %}
