{% extends 'base.html.twig' %}

{% block title %}Verify Your Email{% endblock %}

{% block body %}

<style>

    .verify-container{
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
        background: #f4f6f9;
    }

    .verify-card{
        width: 100%;
        max-width: 600px;
        background: #fff;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        text-align: center;
    }

    .verify-card h1{
        font-size: 2.5rem;
        margin-bottom: 20px;
        color: #333;
    }

    .verify-card p{
        font-size: 1rem;
        color: #666;
        line-height: 1.7;
        margin-bottom: 20px;
    }

    .verify-icon{
        font-size: 70px;
        margin-bottom: 20px;
    }

    .verify-btn{
        display: inline-block;
        margin-top: 15px;
        padding: 12px 25px;
        background: #0d6efd;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        transition: 0.3s ease;
        font-weight: bold;
    }

    .verify-btn:hover{
        background: #0b5ed7;
    }

    @media(max-width: 768px){

        .verify-card{
            padding: 25px;
        }

        .verify-card h1{
            font-size: 2rem;
        }

    }

</style>

<div class="verify-container">

    <div class="verify-card">

        <div class="verify-icon">
            📧
        </div>

        <h1>Verify Your Email</h1>

        <p>
            Thank you for registering.
        </p>

        <p>
            Please check your email inbox and click the verification link
            to activate your account.
        </p>

        <p>
            If you did not create an account, you can safely ignore this email.
        </p>
    </div>

</div>

{% endblock %}