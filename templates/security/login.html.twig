{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-100">

    <form method="post" class="w-full max-w-sm bg-white p-8 rounded-xl shadow-lg">

        <h2 class="text-2xl font-bold text-center mb-6">Please sign in</h2>

        {% if error %}
            <div class="bg-red-100 text-red-700 text-sm p-3 rounded mb-4">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="bg-blue-100 text-blue-700 text-sm p-3 rounded mb-4">
                Logged in as {{ app.user.userIdentifier }} —
                <a href="{{ path('app_logout') }}" class="underline">Logout</a>
            </div>
        {% endif %}

        <label for="inputUsername" class="block font-medium mb-1">Username</label>
        <input
            type="text"
            name="username"
            id="inputUsername"
            value="{{ last_username }}"
            required
            autofocus
            autocomplete="username"
            class="w-full px-3 py-2 mb-4 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        >

        <label for="inputPassword" class="block font-medium mb-1">Password</label>
        <input
            type="password"
            name="password"
            id="inputPassword"
            required
            autocomplete="current-password"
            class="w-full px-3 py-2 mb-4 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        >

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button
            type="submit"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg font-semibold transition"
        >
            Sign in
        </button>
                <p class="text-center text-sm text-gray-600 mt-4">
            Don't have an account?
            <a href="{{ path('app_register') }}" class="text-blue-600 hover:underline">Create account</a>
        </p>
        <a href="{{ path('connect_google') }}">Login with Google</a>
    </form>

</div>
{% endblock %}
