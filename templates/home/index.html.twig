{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

<div class="home-page">

    <!-- Banner -->
    <div class="home-banner">
        <img src="/images/filipino-food-banner.jpg" alt="Banner" class="home-banner-img">
        <div class="home-banner-text">
            <h1 class="home-banner-title">WELCOME TO ANITA'S FRESH DELIGHTS!</h1>
            <p class="home-banner-slogan">Freshly wrapped, lovingly served.</p>
            
            <div class="user-actions" style="margin-top: 20px; padding: 15px; display: flex; gap: 15px; justify-content: center;">
            {% if not app.user %}
            <!-- Login button -->
            <a href="{{ path('app_login') }}" 
               class="login-btn"
               style="background:#007bff; padding:8px 14px; color:#fff; border-radius:4px; text-decoration:none;">
                Login
            </a>

            <!-- Register button -->
            <a href="{{ path('app_register') }}" 
               class="register-btn"
               style="background:#28a745; padding:8px 14px; color:#fff; border-radius:4px; text-decoration:none;">
                Register
            </a>
            {% endif %}
        </div>
        </div>
    </div>

    <!-- Content -->
    <div class="home-content-box">
        <h2>WHY CHOOSE US?</h2>
        <ul>
            <li>Authentic and fresh Filipino food, made daily.</li>
            <li>Traditional flavors with a modern twist.</li>
            <li>Perfect for families, gatherings, and celebrations.</li>
        </ul>
    </div>

    <!-- Services -->
    <div class="home-services">
        <h2>SERVICES WE PROVIDE</h2>

        <div class="home-services-container">

            <div class="home-service-box">
                <h3>FOODS</h3>
                <p>Delicious Filipino dishes cooked fresh every day.</p>
            </div>

            <div class="home-service-box">
                <h3>DRINKS</h3>
                <p>Refreshing beverages to pair with your meals.</p>
            </div>

            <div class="home-service-box">
                <h3>DELIVERY</h3>
                <p>Fast and reliable delivery right to your doorstep.</p>
            </div>

        </div>
    </div>

<section class="home-featured">
    <h2>FEATURED DELIGHTS</h2>

    <div class="featured-container">

        <div class="featured-card">
            <img src="/images/featured/lumpia.jpg" alt="Lumpia">
            <h3>Lumpia</h3>
            <p>Crispy and flavorful Filipino spring rolls.</p>
        </div>

        <div class="featured-card">
            <img src="/images/featured/siomai.png" alt="Siomai">
            <h3>Siomai</h3>
            <p>Juicy dumplings served with our signature sauce.</p>
        </div>

        <div class="featured-card">
            <img src="/images/featured/bbq.png" alt="BBQ">
            <h3>BBQ Skewers</h3>
            <p>Grilled to perfection with authentic Filipino flavor.</p>
        </div>

        <div class="featured-card">
            <img src="/images/featured/kwekkwek.png" alt="Kwek-kwek">
            <h3>Kwek-Kwek</h3>
            <p>Deep-fried quail eggs coated in orange batter.</p>
        </div>

        <div class="featured-card">
            <img src="/images/featured/fishball.png" alt="Fishball">
            <h3>Fishball</h3>
            <p>Classic street food served with sweet and spicy sauce.</p>
        </div>

        <div class="featured-card">
            <img src="/images/featured/isaw.png" alt="Isaw">
            <h3>Isaw</h3>
            <p>Grilled chicken intestines with bold smoky flavor.</p>
        </div>
    </div>
</section>


<section class="home-family">

    <div class="family-container">

        <!-- IMAGE -->
        <div class="family-image">
            <img src="/images/home_family.png" alt="Family Eating">
        </div>

        <!-- TEXT -->
        <div class="family-content">
            <h2>Eat with Your Family</h2>

            <p>
                Nothing brings people together like good food. At Anita's Fresh Delights,
                we believe every meal should be shared with the people you love. Enjoy
                authentic Filipino flavors in a warm and welcoming atmosphere.
            </p>
        </div>

    </div>

</section>

<section class="home-about-cta">

    <div class="about-cta-content">
        <h2>Want to get to know us better?</h2>

        <p>
            Discover our story, our passion for Filipino street food, and what makes
            Anita's Fresh Delights a place people love to come back to.
        </p>

        <a href="{{ path('app_about') }}" class="btn-about">
            Learn More About Us
        </a>
    </div>

</section>
</div>

{% endblock %}
